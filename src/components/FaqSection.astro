---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import type { FaqItem } from "../content/faq";

/** Zero-JS accordion. The page passes the same items to faqJsonLd() for FAQPage markup. */
interface Props {
  items: FaqItem[];
  title?: string;
}

const { items, title = "Dúvidas frequentes" } = Astro.props;
---

<section id="duvidas" class="scroll-mt-20 bg-cream py-20 md:py-28" aria-labelledby="duvidas-titulo">
  <div class="container-page">
    <SectionHeading id="duvidas-titulo" title={title} />
    <div class="mx-auto mt-12 max-w-3xl divide-y divide-hairline rounded-[var(--radius-card-lg)] border border-hairline bg-white px-6 md:px-8">
      {
        items.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-base font-medium [&::-webkit-details-marker]:hidden">
              <h3 class="text-pretty">{item.question}</h3>
              <Icon name="chevron-down" size={20} class="mt-0.5 shrink-0 text-charcoal transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 pr-8 text-[15px] leading-relaxed text-charcoal">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
