---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import type { FaqItem } from "../content/faq";
import { site } from "../config/site";
import { type WhatsAppContext, whatsappLink } from "../config/whatsapp";

/** Zero-JS accordion. The page passes the same items to faqJsonLd() for FAQPage markup. */
interface Props {
  items: FaqItem[];
  title?: string;
  whatsappContext?: WhatsAppContext;
}

const { items, title = "Dúvidas frequentes", whatsappContext = "home" } = Astro.props;
const whatsapp = whatsappLink(whatsappContext);
---

<section id="duvidas" class="scroll-mt-20 bg-cream py-20 md:py-28" aria-labelledby="duvidas-titulo">
  <div class="container-page grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div class="flex flex-col gap-6 lg:sticky lg:top-32 lg:self-start">
      <SectionHeading id="duvidas-titulo" title={title} />
      {
        site.whatsapp.enabled && (
          <p class="max-w-sm text-pretty text-charcoal">
            Não achou a sua dúvida?{" "}
            <a
              href={whatsapp.href}
              target="_blank"
              rel="noopener"
              class="text-ink underline underline-offset-4"
              data-whatsapp
              data-whatsapp-number={whatsapp.number}
              data-whatsapp-message={whatsapp.message}
              data-whatsapp-context={whatsappContext}
              data-whatsapp-placement="faq"
            >
              Fale com a gente pelo WhatsApp
            </a>
            .
          </p>
        )
      }
    </div>
    <div class="divide-y divide-hairline rounded-[var(--radius-card-lg)] border border-hairline bg-white px-6 md:px-8">
      {
        items.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-base font-medium [&::-webkit-details-marker]:hidden">
              <h3 class="text-pretty">{item.question}</h3>
              <Icon name="chevron-down" size={20} class="mt-0.5 shrink-0 text-charcoal transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 pr-8 text-[15px] leading-relaxed text-charcoal">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
