---
import Icon, { type IconName } from "./Icon.astro";

/** One capability: copy on one side, a product card on the other; `reverse` alternates sides. */
interface Props {
  icon: IconName;
  tag: string;
  title: string;
  text: string;
  points: string[];
  reverse?: boolean;
}

const { icon, tag, title, text, points, reverse = false } = Astro.props;
---

<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
  <div class:list={["flex flex-col gap-5", reverse && "lg:order-2"]}>
    <span class="pill-tag self-start"><Icon name={icon} size={15} class="text-sand-deep" /> {tag}</span>
    <h2 class="text-heading text-balance">{title}</h2>
    <p class="text-lg text-pretty text-charcoal">{text}</p>
    <ul class="flex flex-col gap-3 text-[15px]">
      {
        points.map((point) => (
          <li class="flex gap-3">
            <Icon name="check" size={18} class="mt-0.5 shrink-0 text-sand-deep" />
            {point}
          </li>
        ))
      }
    </ul>
  </div>
  <div class:list={["rounded-[var(--radius-card-lg)] bg-cream p-6 md:p-10", reverse && "lg:order-1"]} aria-hidden="true">
    <div class="mx-auto max-w-[460px]">
      <slot />
    </div>
  </div>
</div>
