  face:
    '<path d="M12 3c4.2 0 7 3.3 7 8 0 3.4-1.5 6.2-3.6 8-1 .9-2.2 1.5-3.4 1.5s-2.4-.6-3.4-1.5C6.5 17.2 5 14.4 5 11c0-4.7 2.8-8 7-8Z"/><path d="M9 10.5h.01M15 10.5h.01"/><path d="M10 15.5c1.2.8 2.8.8 4 0"/>',
  calendar:
    '<rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M8 14h2M14 14h2M8 17h2"/>',
