---
/**
 * Single-weight line icons (1.6px stroke), drawn for this site. Colour comes from
 * `currentColor`; icons are decorative unless a `label` is passed.
 */
export type IconName =
  | "tooth"
  | "face"
  | "calendar"
  | "clipboard"
  | "receipt"
  | "chart"
  | "wallet"
  | "calculator"
  | "shield"
  | "lock"
  | "database"
  | "map-pin"
  | "pen"
  | "users"
  | "check"
  | "arrow-right"
  | "chevron-down"
  | "menu"
  | "close"
  | "sparkle"
  | "link"
  | "flask"
  | "eye-off"
  | "refresh"
  | "card";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;

const paths: Record<IconName, string> = {
  tooth:
