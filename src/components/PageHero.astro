---
import CtaButton from "./CtaButton.astro";
import Icon, { type IconName } from "./Icon.astro";

/** Hero band for feature pages: breadcrumb, H1, CTA, and a product card rising from the band. */
interface Props {
  breadcrumb: string;
  tag: string;
  icon: IconName;
  title: string;
  subtitle: string;
  placement: string;
}

const { breadcrumb, tag, icon, title, subtitle, placement } = Astro.props;
---

<section class="px-3 pt-2 md:px-4" aria-labelledby="page-hero-titulo">
  <div class="hero-band relative overflow-hidden rounded-[28px] md:rounded-[40px]">
    <div class="container-page flex flex-col items-center pt-10 text-center md:pt-16">
      <nav aria-label="Trilha" class="text-sm text-ink/70">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-ink">Início</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{breadcrumb}</li>
        </ol>
      </nav>
      <p class="pill-tag mt-8 border-white/70 bg-white/60 backdrop-blur">
        <Icon name={icon} size={14} class="text-sand-deep" />
        {tag}
      </p>
      <h1 id="page-hero-titulo" class="text-display-sm mt-6 max-w-4xl text-balance">{title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-pretty text-ink/75 md:text-xl">{subtitle}</p>
      <div class="mt-9 flex flex-col items-center gap-3">
        <CtaButton placement={placement} />
        <p class="text-sm text-ink/70">10 dias grátis · Cartão de crédito não obrigatório</p>
      </div>
    </div>
    <div class="relative mx-auto mt-14 h-[280px] max-w-xl px-4 md:mt-16 md:h-[320px]" aria-hidden="true">
      <div class="absolute inset-x-4 top-0">
        <slot />
      </div>
    </div>
  </div>
</section>
