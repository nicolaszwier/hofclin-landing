---
/** Section H2 with an optional subtitle. No label above the heading: the heading carries the section. */
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
  align?: "center" | "left";
  class?: string;
}

const { title, subtitle, id, align = "left", class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-4", align === "center" ? "mx-auto max-w-3xl items-center text-center" : "max-w-2xl", className]}>
  <h2 id={id} class="text-heading text-balance">{title}</h2>
  {subtitle && <p class="text-lg text-pretty text-charcoal">{subtitle}</p>}
</div>
