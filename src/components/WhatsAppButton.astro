---
import Icon from "./Icon.astro";
import { type WhatsAppContext, whatsappLink } from "../config/whatsapp";

/**
 * Floating WhatsApp entry, bottom-right. The prefilled message depends on the page.
 * A speech bubble opens beside it while the footer is on screen, unless closed on this page view.
 */
interface Props {
  context: WhatsAppContext;
}

const { context } = Astro.props;
const { number, message, href } = whatsappLink(context);
---

<div
  class="pointer-events-none fixed right-4 z-40 flex items-center gap-3 transition-[bottom] duration-200 md:right-6"
  style="bottom: calc(16px + var(--consent-offset));"
  data-whatsapp-dock
>
  <div
    class="pointer-events-auto invisible relative w-max max-w-[min(20rem,calc(100vw-100px))] translate-x-2 rounded-[var(--radius-card)] border border-hairline bg-white opacity-0 shadow-[var(--shadow-card),var(--shadow-mock)] transition-[opacity,translate,visibility] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] data-open:visible data-open:translate-x-0 data-open:opacity-100"
    data-whatsapp-bubble
  >
    <span
      class="absolute top-1/2 -right-[7px] size-3 -translate-y-1/2 rotate-45 border-t border-r border-hairline bg-white"
      aria-hidden="true"></span>
    <a
      href={href}
      target="_blank"
      rel="noopener"
      class="group relative block py-3 pr-10 pl-4 text-sm"
      data-whatsapp
      data-whatsapp-number={number}
      data-whatsapp-message={message}
      data-whatsapp-context={context}
      data-whatsapp-placement="bubble"
    >
      <span class="block font-medium text-ink">Ficou com alguma dúvida?</span>
      <span
        class="mt-0.5 block text-charcoal underline decoration-hairline-strong underline-offset-4 transition-colors duration-150 group-hover:text-ink group-hover:decoration-ink"
        >Fale com a gente pelo WhatsApp.</span
      >
    </a>
    <button
      type="button"
      class="absolute top-2 right-2 flex size-7 items-center justify-center rounded-full text-slate transition-colors duration-150 hover:bg-cloud hover:text-ink"
      aria-label="Fechar mensagem"
      data-whatsapp-bubble-close
    >
      <Icon name="close" size={16} />
    </button>
  </div>

  <a
    href={href}
    target="_blank"
    rel="noopener"
    class="pointer-events-auto flex size-14 shrink-0 items-center justify-center rounded-full bg-whatsapp text-white shadow-[var(--shadow-button)] transition-[background-color,transform] duration-200 hover:scale-105 hover:bg-whatsapp-hover"
    aria-label="Conversar com o Hofclin pelo WhatsApp"
    data-whatsapp
    data-whatsapp-number={number}
    data-whatsapp-message={message}
    data-whatsapp-context={context}
    data-whatsapp-placement="floating"
  >
    <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor" aria-hidden="true">
      <path
        d="M16.04 3C9 3 3.27 8.7 3.27 15.72c0 2.25.6 4.45 1.72 6.38L3.16 28.8l6.88-1.8a12.8 12.8 0 0 0 6 1.52h.01c7.04 0 12.77-5.7 12.77-12.73C28.82 8.7 23.09 3 16.04 3Zm0 23.33h-.01a10.6 10.6 0 0 1-5.4-1.47l-.39-.23-4.08 1.07 1.09-3.97-.25-.41a10.5 10.5 0 0 1-1.62-5.6c0-5.83 4.77-10.58 10.66-10.58 5.88 0 10.65 4.75 10.65 10.58 0 5.84-4.77 10.6-10.65 10.6Zm5.84-7.93c-.32-.16-1.89-.93-2.18-1.03-.29-.11-.5-.16-.72.16-.21.32-.82 1.03-1.01 1.24-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.58a9.6 9.6 0 0 1-1.78-2.2c-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.72-.98-2.36-.26-.62-.52-.53-.72-.54h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.08-1.11 2.64 0 1.56 1.14 3.06 1.3 3.27.16.21 2.24 3.42 5.43 4.8.76.33 1.35.52 1.81.67.76.24 1.45.2 2 .12.61-.09 1.89-.77 2.15-1.51.27-.74.27-1.38.19-1.51-.08-.13-.29-.21-.61-.37Z"
      ></path>
    </svg>
  </a>
</div>

<script>
  const dock = document.querySelector<HTMLElement>("[data-whatsapp-dock]");
  const bubble = dock?.querySelector<HTMLElement>("[data-whatsapp-bubble]");
  const footer = document.querySelector("footer");

  if (dock && bubble && footer) {
    // Closing or using the bubble keeps it shut for this page view; nothing is stored.
    let dismissed = false;
    const consentBanner = document.querySelector<HTMLElement>("[data-consent-banner]");
    const setOpen = (open: boolean) => bubble.toggleAttribute("data-open", open);

    // Opens near the end of the page: the footer is on screen and the visitor scrolled past the
    // first screen, so a short page that shows its footer on load stays quiet. It waits while the
    // consent banner is open, one prompt at a time. Re-checked on scroll too, since a restored
    // scroll position or a banner closed later never changes the footer's intersection.
    let footerOnScreen = false;
    const update = () =>
      setOpen(footerOnScreen && window.scrollY > window.innerHeight && !dismissed && consentBanner?.hidden !== false);
    new IntersectionObserver(([entry]) => {
      footerOnScreen = entry.isIntersecting;
      update();
    }).observe(footer);
    window.addEventListener("scroll", update, { passive: true });

    dock.addEventListener("click", (event) => {
      const target = event.target as Element;
      if (!target.closest("[data-whatsapp-bubble-close], a[data-whatsapp]")) return;
      dismissed = true;
      setOpen(false);
      // The close button turns invisible; hand focus to the WhatsApp button beside it.
      if (target.closest("[data-whatsapp-bubble-close]"))
        dock.querySelector<HTMLElement>('[data-whatsapp-placement="floating"]')?.focus();
    });
  }
</script>
