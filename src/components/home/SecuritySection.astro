---
import Icon, { type IconName } from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";

/**
 * Only claims the product can prove today — the defensible wording from
 * odonto-web/docs/research/termos-de-uso-privacidade-lgpd-saas.md §5.3.
 */
const items: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "lock",
    title: "Arquivos clínicos criptografados",
    text: "Anexos, fotos e imagens de assinatura ficam guardados com criptografia.",
  },
  {
    icon: "database",
    title: "Backup a cada 6 horas",
    text: "Cópia automática do banco de dados, guardada por 90 dias e protegida contra alteração.",
  },
  {
    icon: "eye-off",
    title: "Conteúdo clínico é da clínica",
    text: "A equipe Hofclin não acessa conteúdo clínico, como anamneses, odontogramas, assinaturas e anexos.",
  },
  {
    icon: "users",
    title: "Cada um vê o que precisa",
    text: "O dentista vê os pacientes que atende, e a secretária só abre o prontuário clínico com permissão do administrador.",
  },
];
---

<section class="border-t border-hairline bg-cream py-20 md:py-28" aria-labelledby="seguranca-titulo">
  <div class="container-page grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div class="flex flex-col gap-8">
      <SectionHeading
        id="seguranca-titulo"
        title="Dados de saúde pedem cuidado"
        subtitle="Prontuário guarda informação sensível. Por isso, dizemos exatamente o que fazemos para protegê-la."
      />
      <a href="/seguranca" class="link-arrow self-start">Veja como protegemos os dados <Icon name="arrow-right" size={16} /></a>
    </div>
    <dl class="border-t border-hairline-strong">
      {
        items.map((item) => (
          <div class="grid grid-cols-1 gap-x-8 gap-y-2 border-b border-hairline py-6 sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)]">
            <dt class="flex items-start gap-3 text-base font-semibold">
              <Icon name={item.icon} size={20} class="mt-0.5 shrink-0 text-sand-deep" />
              {item.title}
            </dt>
            <dd class="text-pretty text-charcoal">{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
