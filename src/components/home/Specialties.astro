---
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";
import TreatmentSessionsMock from "../mockups/TreatmentSessionsMock.astro";
import ApplicationMock from "../mockups/ApplicationMock.astro";

/** The two specialties side by side: each works on its own, and they share the patient's history. */
const columns = [
  {
    icon: "tooth",
    title: "Odontologia",
    text: "Odontograma por dente e face, com o que o paciente já tinha separado do que a clínica planejou.",
    points: [
      "Condições e tratamentos no mesmo mapa",
      "Tratamentos em várias sessões, do planejado ao concluído",
      "Registros por dente ou por região, como arcada ou boca inteira",
    ],
    href: "/odontologia",
    linkLabel: "Conheça o prontuário odontológico",
    mock: "plan",
  },
  {
    icon: "face",
    title: "Harmonização orofacial",
    text: "Faceograma com pontos de aplicação e doses, e a rastreabilidade de cada produto aplicado.",
    points: [
      "Regiões, pontos e doses marcados no rosto, de frente e de perfil",
      "O planejado e o aplicado no mesmo mapa",
      "Marca, lote, validade e foto do rótulo de cada produto",
    ],
    href: "/harmonizacao-orofacial",
    linkLabel: "Conheça o prontuário de harmonização",
    mock: "trace",
  },
] as const;
---

<section class="border-y border-hairline bg-cream py-20 md:py-28" aria-labelledby="especialidades-titulo">
  <div class="container-page">
    <SectionHeading
      id="especialidades-titulo"
      title="Do sorriso ao rosto, sem trocar de sistema"
      subtitle="Cada especialidade tem o seu mapa e funciona sozinha. Quando a clínica faz as duas, o que foi feito na boca e no rosto fica no mesmo histórico do paciente."
    />
    <div class="mt-14 grid grid-cols-1 border-t border-hairline-strong lg:grid-cols-2">
      {
        columns.map((column, index) => (
          <article
            class:list={[
              "flex flex-col gap-6 pt-10",
              index === 0 ? "pb-12 lg:pr-14 lg:pb-0" : "border-t border-hairline-strong lg:border-t-0 lg:border-l lg:pl-14",
            ]}
          >
            <h3 class="flex items-center gap-2.5 text-subheading">
              <Icon name={column.icon} size={26} class="shrink-0 text-sand-deep" />
              {column.title}
            </h3>
            <p class="max-w-lg text-lg text-pretty text-charcoal">{column.text}</p>
            <ul class="flex flex-col gap-2.5 text-[15px]">
              {column.points.map((point) => (
                <li class="flex gap-3">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-sand-deep" />
                  {point}
                </li>
              ))}
            </ul>
            <div class="max-w-[480px]" aria-hidden="true">
              {column.mock === "plan" ? <TreatmentSessionsMock /> : <ApplicationMock />}
            </div>
            <a href={column.href} class="link-arrow self-start">
              {column.linkLabel} <Icon name="arrow-right" size={16} />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
