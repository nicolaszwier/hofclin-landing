---
import Icon from "../Icon.astro";

/** Recreation of the Dashboard's compact agenda list for one day. Fictional data. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const appointments = [
  { time: "08:30", patient: "Marina Alves", procedure: "Avaliação", area: "odonto", status: "Atendido" },
  { time: "09:30", patient: "João Pereira", procedure: "Restauração · 26", area: "odonto", status: "Atendido" },
  { time: "11:00", patient: "Carla Mendes", procedure: "Toxina botulínica", area: "hof", status: "Agendado" },
  { time: "14:00", patient: "Rafael Costa", procedure: "Preenchimento labial", area: "hof", status: "Agendado" },
  { time: "15:30", patient: "Beatriz Lima", procedure: "Limpeza", area: "odonto", status: "Agendado" },
];
---

<div class:list={["mock-card overflow-hidden", className]}>
  <div class="flex items-center justify-between gap-3 border-b border-hairline px-4 py-3">
    <span class="pill-tag"><Icon name="calendar" size={15} class="text-sand-deep" /> Hoje</span>
    <span class="text-xs text-charcoal">qui., 16 de outubro</span>
  </div>
  <ul>
    {
      appointments.map((item) => (
        <li class="flex items-center gap-3 border-b border-hairline px-4 py-2.5 last:border-0">
          <span class="w-10 shrink-0 text-xs font-semibold tabular-nums">{item.time}</span>
          <span class:list={["h-8 w-1 shrink-0 rounded-full", item.area === "hof" ? "bg-sand" : "bg-hairline-strong"]} />
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="truncate text-xs font-medium">{item.patient}</span>
            <span class="truncate text-[11px] text-charcoal">{item.procedure}</span>
          </span>
          <span class:list={["chip", item.status === "Atendido" ? "bg-cloud text-charcoal" : "border border-hairline-strong text-ink"]}>{item.status}</span>
        </li>
      ))
    }
  </ul>
</div>
