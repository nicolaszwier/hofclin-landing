---
import Icon from "../Icon.astro";

/** Recreation of a saved Cost calculation. Fictional data. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const lines = [
  { label: "Insumos (seringa, agulhas, anestésico)", value: "412,00" },
  { label: "Mão de obra", value: "180,00" },
  { label: "Custos fixos rateados", value: "96,00" },
  { label: "Taxa do cartão · crédito 3x", value: "4,9%" },
  { label: "Margem desejada", value: "35%" },
];
---

<div class:list={["mock-card overflow-hidden", className]}>
  <div class="flex items-center justify-between gap-3 border-b border-hairline px-4 py-3">
    <span class="pill-tag"><Icon name="calculator" size={15} class="text-sand-deep" /> Cálculo de custo</span>
    <span class="truncate text-xs text-charcoal">Preenchimento labial</span>
  </div>
  <ul class="px-4 pt-1">
    {
      lines.map((line) => (
        <li class="flex items-center justify-between gap-3 border-b border-hairline py-2 text-[11px]">
          <span class="truncate text-charcoal">{line.label}</span>
          <span class="shrink-0 font-medium tabular-nums">{line.value.includes("%") ? line.value : `R$ ${line.value}`}</span>
        </li>
      ))
    }
  </ul>
  <div class="m-3 flex items-center justify-between rounded-xl bg-sand-soft px-3 py-2.5">
    <span class="text-xs font-medium text-sand-deep">Preço sugerido</span>
    <span class="text-base font-semibold tabular-nums">R$ 1.190,00</span>
  </div>
</div>
