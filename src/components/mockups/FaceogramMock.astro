---
import Icon from "../Icon.astro";
import FaceogramChart from "./FaceogramChart.astro";
import { faceDoses, samplePatient } from "../../content/sample-patient";

/** Recreation of the app's Faceograma (injection points with doses) for the shared fictional patient. */
interface Props {
  compact?: boolean;
  class?: string;
}

const { compact = false, class: className } = Astro.props;
---

<div class:list={["mock-card overflow-hidden", className]}>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-4 py-3">
    <span class="pill-tag"><Icon name="face" size={15} class="text-sand-deep" /> Faceograma</span>
    <span class="text-xs text-charcoal">{samplePatient.name} · {samplePatient.age} anos</span>
  </div>

  <div class="grid grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)] items-center gap-3 px-4 py-4">
    <FaceogramChart />
    <div class="flex flex-col gap-2">
      {
        faceDoses.slice(0, compact ? 4 : faceDoses.length).map((row) => (
          <div class="flex items-center justify-between gap-2 rounded-lg bg-cream px-2.5 py-1.5 text-[11px]">
            <span class="flex min-w-0 items-center gap-1.5">
              <span class:list={["size-2 shrink-0 rounded-full", row.kind === "toxin" ? "bg-sand-deep" : "border-2 border-sand-deep bg-white"]} />
              <span class="truncate">{row.region}</span>
            </span>
            <span class="font-semibold">{row.dose}</span>
          </div>
        ))
      }
    </div>
  </div>

  {
    !compact && (
      <div class="flex flex-wrap gap-x-4 gap-y-1.5 border-t border-hairline px-4 py-3 text-[11px] text-charcoal">
        <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-sand-deep" />Toxina botulínica</span>
        <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-full border-2 border-sand-deep" />Ácido hialurônico</span>
      </div>
    )
  }
</div>
