---
import Icon from "../Icon.astro";

/** Recreation of the Insights hub tabs. Fictional data. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const rows = [
  { patient: "Fernanda Rocha", detail: "Retorno de 6 meses venceu há 12 dias" },
  { patient: "Lucas Martins", detail: "Retorno de toxina venceu há 5 dias" },
  { patient: "Patrícia Souza", detail: "Retorno de 12 meses venceu ontem" },
];
---

<div class:list={["mock-card overflow-hidden", className]}>
  <div class="flex items-center gap-1 overflow-x-auto border-b border-hairline px-3 py-2.5 text-[11px] font-medium whitespace-nowrap">
    <span class="rounded-full bg-ink px-2.5 py-1 text-white">Retornos</span>
    <span class="rounded-full px-2.5 py-1 text-charcoal">Tratamentos pendentes</span>
    <span class="rounded-full px-2.5 py-1 text-charcoal">Aniversários</span>
  </div>
  <ul>
    {
      rows.map((row) => (
        <li class="flex items-center gap-3 border-b border-hairline px-4 py-2.5 last:border-0">
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-sand-soft text-sand-deep">
            <Icon name="refresh" size={14} />
          </span>
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="truncate text-xs font-medium">{row.patient}</span>
            <span class="truncate text-[11px] text-charcoal">{row.detail}</span>
          </span>
        </li>
      ))
    }
  </ul>
</div>
