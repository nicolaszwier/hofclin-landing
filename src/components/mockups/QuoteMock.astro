---
import Icon from "../Icon.astro";

/** Recreation of a Quote with its public link, the link's view stamp, and WhatsApp share. Fictional data. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const items = [
  { label: "Restauração em resina", where: "Dente 26", value: "280,00" },
  { label: "Clareamento caseiro", where: "Arcada superior", value: "950,00" },
  { label: "Toxina botulínica", where: "Terço superior", value: "1.400,00" },
];
---

<div class:list={["mock-card overflow-hidden", className]}>
  <div class="flex items-center justify-between gap-3 border-b border-hairline px-4 py-3">
    <span class="pill-tag"><Icon name="receipt" size={15} class="text-sand-deep" /> Orçamento nº 0142</span>
    <span class="text-xs text-charcoal">Válido até 15/11</span>
  </div>
  {/* The app's carimbo for the public link, in its own format; it never says "Não visualizado". */}
  <p class="flex px-4 pt-2"><span class="chip bg-cloud text-charcoal">Visualizado 2× — última vez há 3 horas</span></p>
  <ul class="px-4">
    {
      items.map((item) => (
        <li class="flex items-center justify-between gap-3 border-b border-hairline py-2.5">
          <span class="flex min-w-0 flex-col">
            <span class="truncate text-xs font-medium">{item.label}</span>
            <span class="text-[11px] text-charcoal">{item.where}</span>
          </span>
          <span class="text-xs tabular-nums">R$ {item.value}</span>
        </li>
      ))
    }
  </ul>
  <div class="flex items-center justify-between px-4 py-3">
    <span class="text-xs text-charcoal">Total</span>
    <span class="text-base font-semibold tabular-nums">R$ 2.630,00</span>
  </div>
  <div class="flex gap-2 border-t border-hairline bg-cream px-4 py-3">
    <span class="flex flex-1 items-center justify-center gap-1.5 rounded-full border border-hairline-strong bg-white py-1.5 text-[11px] font-medium">
      <Icon name="link" size={13} /> Ver orçamento
    </span>
    <span class="flex flex-1 items-center justify-center gap-1.5 rounded-full border border-hairline-strong bg-white py-1.5 text-[11px] font-medium">
      <svg viewBox="0 0 32 32" width="13" height="13" fill="#25d366" aria-hidden="true"><circle cx="16" cy="16" r="13"></circle></svg>
      Enviar no WhatsApp
    </span>
  </div>
</div>
