---
import Base from "../layouts/Base.astro";
import CtaButton from "../components/CtaButton.astro";
---

<Base title="Página não encontrada | Hofclin" description="A página que você procurou não existe." noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center gap-6 py-24 text-center">
    <p class="text-sm font-medium text-sand-deep">Erro 404</p>
    <h1 class="text-heading">Esta página não existe</h1>
    <p class="max-w-md text-lg text-charcoal">O endereço pode ter mudado. Volte para o início ou comece o seu teste grátis.</p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn btn-ghost btn-lg">Ir para o início</a>
      <CtaButton placement="404" label="Testar grátis" />
    </div>
  </section>
</Base>
